DB_URL=postgresql+psycopg2://macbook@localhost:5432/jobs_db
RAW_CSV_PATH=data/data.csv
PROCESSED_CSV_PATH=data/processed/jobs_clean.csv

# csv | crawl
EXTRACT_SOURCE=csv

# TopDev crawl (when EXTRACT_SOURCE=crawl)
CRAWL_MAX_PAGES=10
CRAWL_PAGE_SIZE=50
CRAWL_DELAY_SECONDS=1.0
CRAWL_RAW_CSV_PATH=data/raw/topdev_latest.csv

# interval | cron
SCHEDULE_TYPE=cron
PIPELINE_INTERVAL_MINUTES=60
PIPELINE_CRON_HOUR=2
PIPELINE_CRON_MINUTE=0

# Discord webhook (Channel → Edit → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=
DISCORD_INTERVAL_HOURS=2
DISCORD_STATE_PATH=data/state/discord_notified.json
# file (local) | db (GitHub Actions / shared Postgres)
DISCORD_STATE_BACKEND=file
DISCORD_MAX_MESSAGES=10
